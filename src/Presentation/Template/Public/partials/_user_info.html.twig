<div class="font-mono text-white {{ hasSkills ? 'w-2/3' : 'w-full' }}">
    <div class="card {{ user.profileImagePath ? 'card-side' : '' }} bg-base-100 shadow-sm bg-secondary">
        {% if user.profileImagePath %}
            <figure class="avatar w-36">
                <img
                    src="{{ asset(user.profileImagePath) }}"
                    alt="avatar" />
            </figure>
        {% endif %}
        <div class="card-body">
            {% if user.fullName %}<h1 class="card-title text-3xl">{{ user.fullName }}</h1>{% endif %}
            {% if user.jobTitle %}<h2 class="font-bold text-xl">{{ user.jobTitle }}</h2>{% endif %}
            {% if user.company %}<h3 class="font-sans">{{ user.company }} {{ user.location ? '- '~user.location : '' }}</h3>{% endif %}
        </div>
    </div>
</div>
