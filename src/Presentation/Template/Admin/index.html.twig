{% extends '@app/base.html.twig' %}

{% block content %}
    <div class="w-full">
        <div class="mb-10">
            <h1>Hello {{ app.user.username }}!</h1>
        </div>

        <div class="flex">
            <div class="flex-1 flex-col gap-6">
                {{ component('Admin:AdminProfilePicture', {
                    userId: currentUserId,
                    username: app.user.username,
                    profileImageForm: profileImageForm,
                    profilePicturePath: app.user.profileImagePath,
                    key: 'admin-profile-picture-' ~ (app.user.profileImagePath ? 'exists' : 'deleted'),
                }) }}

                {{ component('Admin:MeInfo', {
                    user: app.user,
                }) }}

                {{ component('Admin:AdminSkills', {
                    userId: currentUserId,
                    skills: skills,
                }) }}
            </div>

            <div class="divider lg:divider-horizontal"></div>

            {{ component('Admin:MeSocialNetworks', {
                userId: currentUserId,
                socialNetworks: socialNetworks,
            }) }}
        </div>

        <div class="flex mt-8 justify-center">
            <a href="/logout" class="btn btn-primary">Se déconnecter</a>
        </div>
    </div>
{% endblock %}
