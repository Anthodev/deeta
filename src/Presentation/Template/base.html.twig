<!DOCTYPE html>
<html data-theme="night" lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
    {{ component('Common:FlashBag') }}
    <div class="navbar bg-base-100 shadow-sm fixed-top z-10">
        <div class="navbar-start"></div>
        <div class="navbar-end">
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <a href="{{ path('app_admin_index') }}" class="btn btn-dash btn-primary">Dashboard</a>
            {% else %}
                <a href="{{ path('app_admin_login') }}" class="btn btn-dash btn-primary">Se connecter</a>
            {% endif %}
        </div>
    </div>
    <div class="flex flex-col items-center justify-center h-screen">
        <div class="container">
            {% block content %}
            {% endblock %}
        </div>
    </div>
    </body>
</html>
