{% extends '@app/base.html.twig' %}

{% block content %}
    <div class="flex w-1/2 mx-auto grid gap-2">
        {%  if user %}
            {% set hasSkills = user.skills|length > 0 %}
            {% set hasSocialNetworks = user.socialNetworks|length > 0 %}
            <div class="flex w-full gap-2">
                {{ include('@app/Public/partials/_user_info.html.twig', {
                    'user': user,
                    'hasSkills': hasSkills,
                }) }}

                {% if hasSkills %}
                    {{ include('@app/Public/partials/_user_skills.html.twig', {
                        'skills': userSortedSkills,
                    }) }}
                {% endif %}
            </div>
            <div>
                {% if hasSocialNetworks %}
                    <div class="divider"></div>

                    {{ include('@app/Public/partials/_user_social_networks.html.twig', {
                        'socialNetworks': userSortedSocialNetworks,
                    }) }}
                {% endif %}
            </div>
        {% else %}
            <div role="alert" class="alert alert-error">
                <span class="w-5">{{ ux_icon('ph:x-circle-bold') }}</span>
                <span>No user in the database.</span>
            </div>
        {% endif %}
    </div>
{% endblock %}
