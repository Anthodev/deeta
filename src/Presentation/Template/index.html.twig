{% extends '@app/base.html.twig' %}

{% block content %}
    <div class="w-1/2 mx-auto">
        {%  if user %}
            {{ component('Public:UserInfo', {
                'fullName': user.fullName,
                'jobTitle': user.jobTitle,
                'company': user.company,
                'location': user.location,
                'profileImagePath': user.profileImagePath,
            }) }}
        {% else %}
            <p>No user found.</p>
        {% endif %}
    </div>
{% endblock %}
