<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
    https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Model\User\User" table="users">
        <id name="id" type="string" column="id" length="36">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Symfony\Bridge\Doctrine\IdGenerator\UlidGenerator"/>
        </id>

        <field name="email" type="string" column="email" length="255">
        </field>

        <field name="username" type="string" column="username" length="255">
        </field>

        <field name="firstName" type="string" column="first_name" length="255" nullable="true">
        </field>

        <field name="lastName" type="string" column="last_name" length="255" nullable="true">
        </field>

        <field name="password" type="string" column="password" length="255">
        </field>

        <field name="plainPassword" type="string" column="plain_password" length="255" nullable="true">
        </field>

        <field name="jobTitle" type="string" column="job_title" length="255" nullable="true">
        </field>

        <field name="company" type="string" column="company" length="255" nullable="true">
        </field>

        <field name="location" type="string" column="location" length="255" nullable="true">
        </field>

        <field name="enabled" type="integer" column="enabled">
            <options>
                <option name="default">0</option>
            </options>
        </field>

        <field name="createdAt" type="datetime" column="created_at">
            <options>
                <option name="default">CURRENT_TIMESTAMP</option>
            </options>
        </field>

        <field name="updatedAt" type="datetime" column="updated_at" nullable="true">
            <options>
                <option name="default">CURRENT_TIMESTAMP</option>
            </options>
        </field>

        <many-to-one
            field="role"
            target-entity="App\Domain\Model\User\Role"
            inversed-by="users"
        />

        <one-to-many
            field="socialNetworks"
            target-entity="App\Domain\Model\Info\SocialNetwork"
            mapped-by="user"
        />

        <one-to-many
            field="skills"
            target-entity="App\Domain\Model\Info\Skill"
            mapped-by="user"
        />

        <indexes>
            <index name="users_email" columns="email"/>
            <index name="users_username" columns="username"/>
            <index name="users_role_id" columns="role_id"/>
        </indexes>

        <unique-constraints>
            <unique-constraint name="users_email_unique_constraint" columns="email"/>
            <unique-constraint name="users_username_unique_constraint" columns="username"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
